# MusicBrainz Application Configuration
# Copy this file to .env.local and fill in your actual values

# Required: Application identification for MusicBrainz API
NEXT_PUBLIC_MUSICBRAINZ_APP_NAME=Your-App-Name
NEXT_PUBLIC_MUSICBRAINZ_CONTACT_EMAIL=your.email@example.com

# OAuth2 Configuration (Optional - only required for personal collections access)
# Register your application at: https://musicbrainz.org/account/applications
# For Confidential clients (Web applications), both CLIENT_ID and CLIENT_SECRET are required
# For Public clients, only CLIENT_ID is needed (CLIENT_SECRET can be omitted)
MUSICBRAINZ_OAUTH_CLIENT_ID=your_client_id_here
MUSICBRAINZ_OAUTH_CLIENT_SECRET=your_client_secret_here
MUSICBRAINZ_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Cookie Security (Optional - defaults to true for HTTPS)
# Set to 'false' ONLY for HTTP deployments (local/Tailscale). Otherwise leave unset for secure default
# COOKIE_SECURE=false

# Optional: Odesli API Key (required for Odesli; without it only MusicBrainz streaming links are shown)
# Get your API key at: https://odesli.co/
# Server-only: do NOT use a NEXT_PUBLIC_ prefix, or the key is shipped to every browser
# ODESLI_API_KEY=your_odesli_api_key_here

# Optional: streaming links by barcode on Spotify and Tidal (Deezer and Apple Music need no key)
# Server-only client credentials: https://developer.spotify.com/dashboard and https://developer.tidal.com
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# TIDAL_CLIENT_ID=your_tidal_client_id
# TIDAL_CLIENT_SECRET=your_tidal_client_secret

# Optional: turn off the background prefetch (defaults to on)
# Use on a dev server that shares its IP with production: MusicBrainz allows about
# 1 request per second per IP, so two prefetching servers slow each other down
# PREFETCH_ENABLED=false
